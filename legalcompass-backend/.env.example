# ==============================================================================
# LegalCompass Backend Environment Variables
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","*"]

# Google Gemini API Configuration (Primary LLM)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-1.5-flash

# Groq Cloud API Configuration (Automatic Failover LLM)
# Get a free key at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.3-70b-versatile

# Provider Preference Order (comma-separated: gemini,groq)
LLM_PROVIDER_ORDER=gemini,groq

# Local Embedding Model (FastEmbed / ONNX CPU - 100% Free)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Upload Security Boundaries
MAX_UPLOAD_SIZE_BYTES=26214400
